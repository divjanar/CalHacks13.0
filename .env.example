# Optional: Photon-compatible geocoding endpoint. No key is needed for the public demo.
VITE_GEOCODER_URL=https://photon.komoot.io/api/

# Backend URL embedded into production frontend builds.
VITE_API_URL=https://table8-api.onrender.com

# Optional: enable Maps JavaScript API and Places API (New) and restrict this browser key to your site.
VITE_GOOGLE_MAPS_API_KEY=
